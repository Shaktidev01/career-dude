# Supabase Connection Pooling (Transaction mode) for Prisma
DATABASE_URL=postgres://postgres.[YOUR-SUPABASE-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Supabase Direct Connection for Prisma Migrations
DIRECT_URL=postgres://postgres.[YOUR-SUPABASE-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:5432/postgres
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production-super-secret-key-at-least-64-characters-long-here

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3001
