# Supabase Connection String for SQLx
DATABASE_URL=postgres://postgres.[YOUR-SUPABASE-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
JWT_SECRET=change-me-in-production-super-secret-key-at-least-64-characters-long-ok
RUST_LOG=info
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000

# Zoho Payments
ZOHO_PAYMENTS_API_KEY=
ZOHO_PAYMENTS_WEBHOOK_SECRET=

# Google OAuth (handled via NextAuth on frontend; backend validates JWT)
# AI Engine
GEMINI_API_KEY=your-gemini-api-key-here
